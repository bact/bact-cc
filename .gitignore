# --- Hugo build output / caches ---
/public/
/resources/_gen/
/.hugo_build.lock
# --- WordPress export working dir (raw dumps; regenerate with tools/wp_export.py) ---
/_export/
# --- Secrets & local config: NEVER commit ---
.env
.env.*
*.env
.dev.vars
.wrangler/
*.pem
*.key
*.sql
*.sql.gz
wp-config.php
*.wpress
*.xml.bak
# wp WXR exports contain emails/hashes of users and commenters
/*.xml
# --- Editors / OS ---
.idea/
.vscode/
.DS_Store
node_modules/
